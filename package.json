{
  "name": "blyp-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002 --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "check:examples": "tsc -p tsconfig.examples.json --noEmit",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/prepare-cloudflare.mjs",
    "preview": "pnpm build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "pnpm build:cloudflare && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@farming-labs/docs": "0.2.111",
    "@farming-labs/next": "0.2.111",
    "@farming-labs/theme": "0.2.111",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "lucide-react": "^0.564.0",
    "motion": "^12.38.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "thesvg": "^2.1.8"
  },
  "devDependencies": {
    "@blyp/core": "github:Blyphq/blyp#v0.1.22",
    "@opennextjs/cloudflare": "^1.20.10",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
